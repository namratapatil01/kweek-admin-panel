{
  "info": {
    "name": "KWEEK Worker API",
    "description": "Worker APIs for Nexa_worker Flutter app migration from Firebase to Laravel/MySQL",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000" },
    { "key": "token", "value": "" },
    { "key": "job_id", "value": "" },
    { "key": "provider_id", "value": "" },
    { "key": "worker_email", "value": "tpenvarne3@godaddy.com" },
    { "key": "worker_password", "value": "password123" },
    { "key": "setting_key", "value": "Version" },
    { "key": "notification_type", "value": "provider_service_intransit" },
    { "key": "since", "value": "2026-07-10T00:00:00+05:30" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Raj\",\n  \"lastName\": \"Worker\",\n  \"email\": \"worker{{$timestamp}}@example.com\",\n  \"phoneNumber\": \"9999999999\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\",\n  \"providerId\": \"{{provider_id}}\",\n  \"address\": \"Bangalore\",\n  \"salary\": \"15000\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/worker/register"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  var json = pm.response.json();",
                  "  if (json.token) pm.collectionVariables.set('token', json.token);",
                  "  if (json.worker && json.worker.providerId) pm.collectionVariables.set('provider_id', json.worker.providerId);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{worker_email}}\",\n  \"password\": \"{{worker_password}}\",\n  \"fcmToken\": \"test-fcm-token\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/worker/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  var json = pm.response.json();",
                  "  if (json.token) pm.collectionVariables.set('token', json.token);",
                  "  if (json.worker && json.worker.providerId) pm.collectionVariables.set('provider_id', json.worker.providerId);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Forgot Password",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{worker_email}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/worker/password/forgot"
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{worker_email}}\",\n  \"token\": \"TOKEN_FROM_EMAIL\",\n  \"password\": \"newpassword123\",\n  \"password_confirmation\": \"newpassword123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/worker/password/reset"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/worker/logout"
          }
        },
        {
          "name": "Delete Account",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/worker/account"
          }
        }
      ]
    },
    {
      "name": "Settings (Public)",
      "item": [
        {
          "name": "All Settings",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/worker/settings"
          }
        },
        {
          "name": "Languages",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/worker/settings/languages"
          }
        },
        {
          "name": "Setting By Key",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/worker/settings/{{setting_key}}"
          }
        },
        {
          "name": "Version",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/worker/settings/Version"
          }
        },
        {
          "name": "Google Map Key",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/worker/settings/googleMapKey"
          }
        },
        {
          "name": "Placeholder Image",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/worker/settings/placeHolderImage"
          }
        },
        {
          "name": "Notification Setting",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/worker/settings/notification_setting"
          }
        },
        {
          "name": "Terms",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/worker/terms"
          }
        },
        {
          "name": "Privacy",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/worker/privacy"
          }
        }
      ]
    },
    {
      "name": "Profile",
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/worker/profile"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  var json = pm.response.json();",
                  "  var worker = json.data || json.worker;",
                  "  if (worker && worker.providerId) pm.collectionVariables.set('provider_id', worker.providerId);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"9999999999\",\n  \"address\": \"Bangalore\",\n  \"latitude\": 12.9716,\n  \"longitude\": 77.5946\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/worker/profile"
          }
        },
        {
          "name": "Upload Profile Image",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "formdata",
              "formdata": [{ "key": "image", "type": "file", "src": "" }]
            },
            "url": "{{base_url}}/api/worker/profile/image"
          }
        },
        {
          "name": "Set Online",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"online\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/worker/availability"
          }
        },
        {
          "name": "Parent Provider",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/worker/provider"
          }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Home (Public)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/worker/home"
          }
        },
        {
          "name": "Dashboard",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/worker/dashboard"
          }
        },
        {
          "name": "Realtime Poll",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/worker/realtime/poll?since={{since}}",
              "host": ["{{base_url}}"],
              "path": ["api", "worker", "realtime", "poll"],
              "query": [{ "key": "since", "value": "{{since}}" }]
            }
          }
        },
        {
          "name": "Realtime Poll (Upcoming Tab)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/worker/realtime/poll?since={{since}}&tab=upcoming",
              "host": ["{{base_url}}"],
              "path": ["api", "worker", "realtime", "poll"],
              "query": [
                { "key": "since", "value": "{{since}}" },
                { "key": "tab", "value": "upcoming" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Jobs",
      "item": [
        {
          "name": "List Upcoming",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/worker/jobs?tab=upcoming"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  var json = pm.response.json();",
                  "  var items = json.data || [];",
                  "  if (items.length && items[0].id) pm.collectionVariables.set('job_id', items[0].id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "List Today",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/worker/jobs?tab=today"
          }
        },
        {
          "name": "List Ongoing",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/worker/jobs?tab=ongoing"
          }
        },
        {
          "name": "List Completed",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/worker/jobs?tab=completed"
          }
        },
        {
          "name": "List Cancelled",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/worker/jobs?tab=cancelled"
          }
        },
        {
          "name": "Job Details",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/worker/jobs/{{job_id}}"
          }
        },
        {
          "name": "Accept Job",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/worker/jobs/{{job_id}}/accept"
          }
        },
        {
          "name": "Reject Job",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Unavailable\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/worker/jobs/{{job_id}}/reject"
          }
        },
        {
          "name": "Start Job",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/worker/jobs/{{job_id}}/start"
          }
        },
        {
          "name": "Stop Timer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/worker/jobs/{{job_id}}/stop-timer"
          }
        },
        {
          "name": "Add Extra Charges",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"extraCharges\": 100,\n  \"extraChargesDescription\": \"Extra parts\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/worker/jobs/{{job_id}}/extra-charges"
          }
        },
        {
          "name": "Complete Job",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"otp\": \"123456\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/worker/jobs/{{job_id}}/complete"
          }
        },
        {
          "name": "Update Job Status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Order Ongoing\",\n  \"otp\": \"123456\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/worker/jobs/{{job_id}}/status"
          }
        }
      ]
    },
    {
      "name": "Chat",
      "item": [
        {
          "name": "Inbox",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/worker/chat/inbox"
          }
        },
        {
          "name": "Messages",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/worker/chat/{{job_id}}/messages"
          }
        },
        {
          "name": "Send Message",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{job_id}}\",\n  \"receiverId\": \"\",\n  \"message\": \"I am on the way\",\n  \"messageType\": \"text\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/worker/chat/send"
          }
        },
        {
          "name": "Upload Media",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": "" },
                { "key": "mediaType", "type": "text", "value": "image" }
              ]
            },
            "url": "{{base_url}}/api/worker/chat/upload"
          }
        }
      ]
    },
    {
      "name": "Reviews & Misc",
      "item": [
