            "body": {
              "mode": "raw",
              "raw": "{\n  \"documents\": [\n    { \"id\": \"doc1\", \"frontURL\": \"https://example.com/front.jpg\" }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
