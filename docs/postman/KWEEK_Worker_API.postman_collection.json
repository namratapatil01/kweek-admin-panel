          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/worker/notifications"
          }
        },
        {
          "name": "Notification Template",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/worker/notifications/templates/{{notification_type}}"
          }
        },
        {
          "name": "Notification Template (Service In Transit)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/worker/notifications/templates/provider_service_intransit"
          }
        },
        {
          "name": "Notification Template (Stop Time)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/worker/notifications/templates/provider_stop_time"
          }
        },
        {
          "name": "Notification Template (Worker Rejected)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/worker/notifications/templates/worker_rejected"
          }
        },
        {
          "name": "Document Templates",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/worker/documents"
          }
