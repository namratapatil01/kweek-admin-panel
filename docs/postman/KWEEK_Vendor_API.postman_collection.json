{
  "info": {
    "name": "KWEEK Vendor API",
    "description": "Vendor/Store APIs for emart_vendor Flutter app migration from Firebase to Laravel/MySQL",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000" },
    { "key": "token", "value": "" },
    { "key": "section_id", "value": "6285dcf511651" },
    { "key": "order_id", "value": "" },
    { "key": "product_id", "value": "" },
    { "key": "driver_id", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Raj\",\n  \"lastName\": \"Store\",\n  \"email\": \"vendor@example.com\",\n  \"phoneNumber\": \"9999999999\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\",\n  \"sectionId\": \"{{section_id}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/vendor/register"
          },
          "event": [{ "listen": "test", "script": { "exec": ["if (pm.response.code === 200 || pm.response.code === 201) { var json = pm.response.json(); if (json.token) pm.collectionVariables.set('token', json.token); }"] } }]
        },
        {
          "name": "Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"vendor@example.com\",\n  \"password\": \"password123\",\n  \"fcmToken\": \"\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/vendor/login"
          },
          "event": [{ "listen": "test", "script": { "exec": ["if (pm.response.code === 200) { var json = pm.response.json(); if (json.token) pm.collectionVariables.set('token', json.token); }"] } }]
        },
        { "name": "Logout", "request": { "method": "POST", "url": "{{base_url}}/api/vendor/logout" } }
      ]
    },
    {
      "name": "Store & Profile",
      "item": [
        { "name": "Get Profile", "request": { "method": "GET", "url": "{{base_url}}/api/vendor/profile" } },
        {
          "name": "Create Store",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"My Restaurant\",\n  \"description\": \"Best food in town\",\n  \"latitude\": 12.9716,\n  \"longitude\": 77.5946,\n  \"isSelfDelivery\": true,\n  \"dine_in_active\": false\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/vendor/store"
          }
        },
        { "name": "Get Store", "request": { "method": "GET", "url": "{{base_url}}/api/vendor/store" } },
        { "name": "Dashboard", "request": { "method": "GET", "url": "{{base_url}}/api/vendor/dashboard" } },
        { "name": "Home (Public)", "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{base_url}}/api/vendor/home" } }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "List New Orders",
          "request": { "method": "GET", "url": "{{base_url}}/api/vendor/orders?tab=new" },
          "event": [{ "listen": "test", "script": { "exec": ["var json = pm.response.json(); if (json.data && json.data.data && json.data.data.length) pm.collectionVariables.set('order_id', json.data.data[0].id);"] } }]
        },
        { "name": "Order Detail", "request": { "method": "GET", "url": "{{base_url}}/api/vendor/orders/{{order_id}}" } },
        { "name": "Accept Order", "request": { "method": "POST", "url": "{{base_url}}/api/vendor/orders/{{order_id}}/accept" } },
        {
          "name": "Reject Order",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"reason\": \"Out of stock\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{base_url}}/api/vendor/orders/{{order_id}}/reject"
          }
        },
        { "name": "Complete Order", "request": { "method": "POST", "url": "{{base_url}}/api/vendor/orders/{{order_id}}/complete" } },
        {
          "name": "Assign Driver",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"driverId\": \"{{driver_id}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{base_url}}/api/vendor/orders/{{order_id}}/assign-driver"
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        { "name": "List Products", "request": { "method": "GET", "url": "{{base_url}}/api/vendor/products" } },
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Margherita Pizza\",\n  \"description\": \"Classic pizza\",\n  \"price\": 299,\n  \"publish\": true,\n  \"veg\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/vendor/products"
          },
          "event": [{ "listen": "test", "script": { "exec": ["var json = pm.response.json(); if (json.data && json.data.id) pm.collectionVariables.set('product_id', json.data.id);"] } }]
        },
        { "name": "Product Detail", "request": { "method": "GET", "url": "{{base_url}}/api/vendor/products/{{product_id}}" } }
      ]
    },
    {
      "name": "Wallet",
      "item": [
        { "name": "Balance", "request": { "method": "GET", "url": "{{base_url}}/api/vendor/wallet" } },
        { "name": "Transactions", "request": { "method": "GET", "url": "{{base_url}}/api/vendor/wallet/transactions" } },
        {
          "name": "Withdraw",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"amount\": 100,\n  \"withdrawMethod\": \"bank\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{base_url}}/api/vendor/wallet/withdraw"
          }
        }
      ]
    },
    {
      "name": "Drivers",
      "item": [
        { "name": "List Drivers", "request": { "method": "GET", "url": "{{base_url}}/api/vendor/drivers" } },
        {
          "name": "Create Driver",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Delivery\",\n  \"lastName\": \"Boy\",\n  \"email\": \"driver.store@example.com\",\n  \"phoneNumber\": \"8888888888\",\n  \"carNumber\": \"KA01XY9999\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/vendor/drivers"
          },
          "event": [{ "listen": "test", "script": { "exec": ["var json = pm.response.json(); if (json.data && json.data.driver && json.data.driver.id) pm.collectionVariables.set('driver_id', json.data.driver.id);"] } }]
        }
      ]
    },
    {
      "name": "Misc",
      "item": [
        { "name": "Catalog (Public)", "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{base_url}}/api/vendor/catalog" } },
        { "name": "Subscription Plans", "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{base_url}}/api/vendor/subscriptions/plans" } },
        { "name": "Documents", "request": { "method": "GET", "url": "{{base_url}}/api/vendor/documents" } },
        { "name": "Notifications", "request": { "method": "GET", "url": "{{base_url}}/api/vendor/notifications" } }
      ]
    }
  ]
}
