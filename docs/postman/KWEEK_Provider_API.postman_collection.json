              "mode": "raw",
              "raw": "{\n  \"id_token\": \"APPLE_IDENTITY_TOKEN\",\n  \"fcmToken\": \"\",\n  \"firstName\": \"Alex\",\n  \"lastName\": \"Provider\",\n  \"email\": \"provider@example.com\",\n  \"auto_register\": true\n}",
              "options": { "raw": { "language": "json" } }
