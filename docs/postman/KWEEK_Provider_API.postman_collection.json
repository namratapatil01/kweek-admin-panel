            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"AC Repair\",\n  \"description\": \"Split AC repair and service\",\n  \"price\": 499,\n  \"disPrice\": 399,\n  \"priceUnit\": \"Fixed\",\n  \"categoryId\": \"\",\n  \"sectionId\": \"\",\n  \"address\": \"Bangalore\",\n  \"latitude\": 12.9716,\n  \"longitude\": 77.5946,\n  \"publish\": true,\n  \"startTime\": \"09:00\",\n  \"endTime\": \"18:00\",\n  \"days\": [\"Monday\", \"Tuesday\", \"Wednesday\", \"Thursday\", \"Friday\"]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/provider/services"
