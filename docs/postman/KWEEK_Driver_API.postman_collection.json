{
  "info": {
    "name": "KWEEK Driver API",
    "description": "Driver APIs for emart_driver Flutter app migration from Firebase to Laravel/MySQL",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000" },
    { "key": "token", "value": "" },
    { "key": "section_id", "value": "6285dcf511651" },
    { "key": "order_type", "value": "vendor" },
    { "key": "order_id", "value": "" },
    { "key": "fleet_driver_id", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Raj\",\n  \"lastName\": \"Driver\",\n  \"email\": \"driver@example.com\",\n  \"phoneNumber\": \"9999999999\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\",\n  \"serviceType\": \"delivery-service\",\n  \"sectionId\": \"{{section_id}}\",\n  \"carName\": \"Swift\",\n  \"carNumber\": \"KA01AB1234\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/driver/register"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "if (pm.response.code === 200 || pm.response.code === 201) {",
                "  var json = pm.response.json();",
                "  if (json.token) pm.collectionVariables.set('token', json.token);",
                "}"
              ]
            }
          }]
        },
        {
          "name": "Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"driver@example.com\",\n  \"password\": \"password123\",\n  \"fcmToken\": \"\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/driver/login"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "if (pm.response.code === 200) {",
                "  var json = pm.response.json();",
                "  if (json.token) pm.collectionVariables.set('token', json.token);",
                "}"
              ]
            }
          }]
        },
        {
          "name": "Google Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_token\": \"GOOGLE_ID_TOKEN\",\n  \"fcmToken\": \"\",\n  \"serviceType\": \"delivery-service\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/driver/auth/google"
          }
        },
        {
          "name": "Apple Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_token\": \"APPLE_ID_TOKEN\",\n  \"fcmToken\": \"\",\n  \"serviceType\": \"cab-service\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/driver/auth/apple"
          }
        },
        {
          "name": "Phone Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"9999999999\",\n  \"countryCode\": \"+91\",\n  \"fcmToken\": \"\",\n  \"serviceType\": \"delivery-service\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/driver/auth/phone"
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"driver@example.com\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/driver/password/forgot"
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"driver@example.com\",\n  \"token\": \"TOKEN_FROM_EMAIL\",\n  \"password\": \"newpassword123\",\n  \"password_confirmation\": \"newpassword123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/driver/password/reset"
          }
        },
        { "name": "Logout", "request": { "method": "POST", "url": "{{base_url}}/api/driver/logout" } },
        { "name": "Delete Account", "request": { "method": "DELETE", "url": "{{base_url}}/api/driver/account" } }
      ]
    },
    {
      "name": "Profile",
      "item": [
        { "name": "Get Profile", "request": { "method": "GET", "url": "{{base_url}}/api/driver/profile" } },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"9999999999\",\n  \"carName\": \"Swift\",\n  \"carNumber\": \"KA01AB1234\",\n  \"vehicleType\": \"bike\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/driver/profile"
          }
        },
        {
          "name": "Upload Profile Image",
          "request": {
            "method": "POST",
            "body": { "mode": "formdata", "formdata": [{ "key": "image", "type": "file", "src": "" }] },
            "url": "{{base_url}}/api/driver/profile/image"
          }
        },
        {
          "name": "Set Online",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"online\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/driver/availability"
          }
        },
        {
          "name": "Update Location",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitude\": 12.9716,\n  \"longitude\": 77.5946,\n  \"rotation\": 90\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/driver/location"
          }
        },
        {
          "name": "Update Bank Details",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userBankDetails\": {\n    \"accountNumber\": \"1234567890\",\n    \"bankName\": \"HDFC\",\n    \"holderName\": \"Raj Driver\"\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/driver/bank-details"
          }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Home (Public)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{base_url}}/api/driver/home?serviceType=delivery-service"
          }
        },
        { "name": "Dashboard", "request": { "method": "GET", "url": "{{base_url}}/api/driver/dashboard" } },
        {
          "name": "Catalog (Public)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{base_url}}/api/driver/catalog"
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "List Available",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/driver/orders?type={{order_type}}&tab=available"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "var json = pm.response.json();",
                "if (json.data && json.data.data && json.data.data.length) {",
                "  pm.collectionVariables.set('order_id', json.data.data[0].id);",
                "}"
              ]
            }
          }]
        },
        {
          "name": "List Active",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/driver/orders?type={{order_type}}&tab=active"
          }
        },
        {
          "name": "List Completed",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/driver/orders?type={{order_type}}&tab=completed"
          }
        },
        { "name": "Order Details", "request": { "method": "GET", "url": "{{base_url}}/api/driver/orders/{{order_type}}/{{order_id}}" } },
        { "name": "Accept Order", "request": { "method": "POST", "url": "{{base_url}}/api/driver/orders/{{order_type}}/{{order_id}}/accept" } },
        {
          "name": "Reject Order",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Too far\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/driver/orders/{{order_type}}/{{order_id}}/reject"
          }
        },
        {
          "name": "Start Order",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"otp\": \"1234\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/driver/orders/{{order_type}}/{{order_id}}/start"
          }
        },
        {
          "name": "Complete Order",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"otp\": \"1234\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/driver/orders/{{order_type}}/{{order_id}}/complete"
          }
        }
      ]
    },
    {
      "name": "Wallet",
      "item": [
        { "name": "Balance", "request": { "method": "GET", "url": "{{base_url}}/api/driver/wallet" } },
        { "name": "Transactions", "request": { "method": "GET", "url": "{{base_url}}/api/driver/wallet/transactions" } },
        { "name": "Earnings", "request": { "method": "GET", "url": "{{base_url}}/api/driver/earnings" } },
        {
          "name": "Withdraw",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 100,\n  \"withdrawMethod\": \"bank\",\n  \"note\": \"Weekly payout\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/driver/wallet/withdraw"
          }
        },
        { "name": "Payout History", "request": { "method": "GET", "url": "{{base_url}}/api/driver/wallet/payouts" } },
        { "name": "Get Withdraw Method", "request": { "method": "GET", "url": "{{base_url}}/api/driver/withdraw-method" } },
        {
          "name": "Save Withdraw Method",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stripe\": { \"accountId\": \"acct_xxx\" }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/driver/withdraw-method"
          }
        }
      ]
    },
    {
      "name": "Chat",
      "item": [
        { "name": "Inbox", "request": { "method": "GET", "url": "{{base_url}}/api/driver/chat/inbox" } },
        { "name": "Messages", "request": { "method": "GET", "url": "{{base_url}}/api/driver/chat/{{order_id}}/messages" } },
        {
          "name": "Send Message",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{order_id}}\",\n  \"receiverId\": \"\",\n  \"message\": \"On my way\",\n  \"messageType\": \"text\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/driver/chat/send"
          }
        },
        {
          "name": "Upload Media",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": "" },
                { "key": "mediaType", "type": "text", "value": "image" }
              ]
            },
            "url": "{{base_url}}/api/driver/chat/upload"
          }
        }
      ]
    },
    {
      "name": "Reviews & Misc",
      "item": [
        { "name": "List Reviews", "request": { "method": "GET", "url": "{{base_url}}/api/driver/reviews" } },
        { "name": "Review By Order", "request": { "method": "GET", "url": "{{base_url}}/api/driver/reviews/order/{{order_id}}" } },
        { "name": "Ratings", "request": { "method": "GET", "url": "{{base_url}}/api/driver/ratings" } },
        { "name": "Notifications", "request": { "method": "GET", "url": "{{base_url}}/api/driver/notifications" } },
        { "name": "Terms", "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{base_url}}/api/driver/terms" } },
        { "name": "Privacy", "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{base_url}}/api/driver/privacy" } },
        { "name": "Document Templates", "request": { "method": "GET", "url": "{{base_url}}/api/driver/documents" } },
        { "name": "Document Status", "request": { "method": "GET", "url": "{{base_url}}/api/driver/documents/status" } },
        {
          "name": "Submit Documents",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"documents\": [\n    { \"id\": \"doc1\", \"frontURL\": \"https://example.com/front.jpg\" }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/driver/documents"
          }
        }
      ]
    },
    {
      "name": "Fleet Owner",
      "item": [
        { "name": "List Fleet Drivers", "request": { "method": "GET", "url": "{{base_url}}/api/driver/owner/drivers" } },
        {
          "name": "Create Fleet Driver",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Fleet\",\n  \"lastName\": \"Driver\",\n  \"email\": \"fleet.driver@example.com\",\n  \"phoneNumber\": \"8888888888\",\n  \"password\": \"password123\",\n  \"carNumber\": \"KA02CD5678\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/driver/owner/drivers"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "var json = pm.response.json();",
                "if (json.data && json.data.driver && json.data.driver.id) {",
                "  pm.collectionVariables.set('fleet_driver_id', json.data.driver.id);",
                "}"
              ]
            }
          }]
        },
        { "name": "Fleet Driver Detail", "request": { "method": "GET", "url": "{{base_url}}/api/driver/owner/drivers/{{fleet_driver_id}}" } },
        {
          "name": "Update Fleet Driver",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"active\": true,\n  \"carNumber\": \"KA02CD9999\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/driver/owner/drivers/{{fleet_driver_id}}"
          }
        }
      ]
    }
  ]
}
